page { background: #0f1117; }
.container { padding: 30rpx; padding-bottom: 50rpx; }
.page-title { font-size: 44rpx; font-weight: bold; margin-bottom: 30rpx; color: #fff; }
.section { padding: 40rpx; margin-bottom: 30rpx; }
.section-label { display: block; font-size: 30rpx; color: rgba(255,255,255,0.7); margin-bottom: 30rpx; }
.freq-grid { display: flex; flex-direction: column; gap: 16rpx; }
.freq-item { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; border-radius: 20rpx; border: 1rpx solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); }
.freq-item.active { border-color: #00d4ff; background: rgba(0,212,255,0.12); }
.freq-emoji { font-size: 44rpx; }
.freq-label { font-size: 30rpx; color: rgba(255,255,255,0.85); }
.loading-wrap { display: flex; justify-content: center; align-items: center; height: 60vh; }
.loading-text { font-size: 36rpx; color: #00d4ff; }
.plan-header { margin-bottom: 10rpx; }
.day-card { display: flex; align-items: flex-start; gap: 24rpx; padding: 30rpx 32rpx; margin-bottom: 16rpx; }
.day-icon { font-size: 50rpx; margin-top: 4rpx; }
.day-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.day-name { font-size: 32rpx; font-weight: 600; color: #fff; }
.day-type { font-size: 22rpx; font-weight: 500; padding: 4rpx 16rpx; border-radius: 20rpx; display: inline-block; width: fit-content; }
.day-type.train { background: rgba(0,212,255,0.15); color: #00d4ff; }
.day-type.recover { background: rgba(0,255,136,0.15); color: #00ff88; }
.day-type.rest { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.5); }
.day-content { font-size: 26rpx; color: rgba(255,255,255,0.65); line-height: 1.5; }
.tips-card { display: flex; align-items: flex-start; gap: 20rpx; padding: 30rpx; margin-top: 10rpx; margin-bottom: 30rpx; border-color: rgba(0,255,136,0.2); background: rgba(0,255,136,0.05); }
.tips-icon { font-size: 40rpx; }
.tips-text { flex: 1; font-size: 26rpx; color: #86efac; line-height: 1.6; }
.reset-btn { width: 100%; }
