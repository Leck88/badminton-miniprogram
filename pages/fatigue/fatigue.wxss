page { background: #0f1117; }
.container { padding: 30rpx; }
.page-title { font-size: 44rpx; font-weight: bold; margin-bottom: 30rpx; color: #fff; }
.progress-wrap { display: flex; align-items: center; gap: 20rpx; margin-bottom: 40rpx; }
.progress-bar { flex: 1; height: 8rpx; background: rgba(255,255,255,0.1); border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #00d4ff, #00ff88); border-radius: 4rpx; transition: width 0.3s; }
.progress-text { color: rgba(255,255,255,0.4); font-size: 24rpx; width: 80rpx; text-align: right; }
.q-card { padding: 50rpx 40rpx; }
.q-num { display: block; color: #00d4ff; font-size: 24rpx; font-weight: 600; margin-bottom: 16rpx; }
.q-text { display: block; font-size: 36rpx; font-weight: bold; color: #fff; line-height: 1.5; margin-bottom: 40rpx; }
.options { display: flex; flex-direction: column; gap: 20rpx; }
.option-item { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; border-radius: 20rpx; border: 1rpx solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); }
.option-icon { font-size: 44rpx; }
.option-text { font-size: 30rpx; color: rgba(255,255,255,0.85); }
.loading-wrap { display: flex; justify-content: center; align-items: center; height: 60vh; }
.loading-text { font-size: 36rpx; color: #00d4ff; }
.result-card { padding: 50rpx; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.result-card.low { border-color: rgba(34,197,94,0.4); background: rgba(34,197,94,0.08); }
.result-card.medium { border-color: rgba(234,179,8,0.4); background: rgba(234,179,8,0.08); }
.result-card.high { border-color: rgba(239,68,68,0.4); background: rgba(239,68,68,0.08); }
.result-icon { font-size: 80rpx; }
.result-level { font-size: 44rpx; font-weight: bold; color: #fff; }
.result-score { font-size: 26rpx; color: rgba(255,255,255,0.4); }
.advice-card { padding: 40rpx; margin-bottom: 24rpx; }
.advice-title { display: block; font-size: 28rpx; font-weight: 600; color: #00d4ff; margin-bottom: 16rpx; }
.advice-text { display: block; font-size: 30rpx; color: rgba(255,255,255,0.85); line-height: 1.6; }
.areas-card { padding: 40rpx; margin-bottom: 40rpx; }
.areas-title { display: block; font-size: 28rpx; font-weight: 600; color: #00d4ff; margin-bottom: 20rpx; }
.areas { display: flex; flex-wrap: wrap; gap: 16rpx; }
.reset-btn { width: 100%; }
